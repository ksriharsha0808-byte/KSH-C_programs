# Copy this file to .env and paste your Groq Cloud API key.
# Do not commit .env. The key is only read by server.js (never by the browser).
#
# Get a key at https://console.groq.com/keys (it starts with gsk_)
XAI_API_KEY=your_groq_api_key_here
# Optional alias (server.js accepts either name):
# GROQ_API_KEY=your_groq_api_key_here
